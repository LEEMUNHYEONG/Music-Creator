{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "predeploy": ["python3 bump_version.py"],
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".gitignore",
      "*.py",
      "*.md",
      "functions/**",
      "node_modules/**",
      "*.wav",
      "Music-Creator/**",
      "tests/**",
      "src/**",
      "music-creator-react/**",
      ".git/**",
      ".vscode/**",
      ".cursor/**",
      ".agents/**",
      ".agent/**",
      ".gemini/**",
      "app_from_backup.js",
      "extract*.py",
      "rebuild*.py",
      "refactor.py",
      "scan_perf.py",
      "find_lines.py",
      "check_bal.py",
      "clean_app.py"
    ],
    "rewrites": [
      {
        "source": "/api/chat",
        "function": "chatProxy"
      },
      {
        "source": "/api/gemini",
        "function": "geminiProxy"
      }
    ],
    "headers": [
      {
        "source": "**/*.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run lint"]
    }
  ],
  "emulators": {
    "functions": {
      "port": 5003
    },
    "firestore": {
      "port": 8082
    },
    "hosting": {
      "port": 5005
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4001
    },
    "auth": {
      "port": 9099
    },
    "singleProjectMode": true
  }
}
