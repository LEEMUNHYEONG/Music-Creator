rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // users 컬렉션: 로그인한 사용자만 자신의 문서 읽기 가능
    // 관리자는 모든 문서 읽기/쓰기 가능
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.role == 'user'
                    && request.resource.data.approved == false;
      allow update: if request.auth != null && (
        isAdmin()
        || (
          request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'musicCreatorGuidelines',
            'guidelinesBackupLatest',
            'updatedAt'
          ])
        )
      );
      allow delete: if request.auth != null && isAdmin();
    }

    // users/{userId}/projects 하위 컬렉션 권한 (자동 백업용)
    // 승인(approved)된 본인 또는 관리자만 접근 가능
    match /users/{userId}/projects/{projectId} {
      allow read, write: if request.auth != null
        && ((request.auth.uid == userId && isApproved()) || isAdmin());
    }

    // users/{userId}/projects/{projectId}/history 시간대별 백업 히스토리 권한
    match /users/{userId}/projects/{projectId}/history/{historyId} {
      allow read, write: if request.auth != null
        && ((request.auth.uid == userId && isApproved()) || isAdmin());
    }

    // config 컬렉션: 관리자만 읽기/쓰기 가능
    match /config/{document=**} {
      allow read: if request.auth != null && isAdmin();
      allow write: if request.auth != null && isAdmin();
    }

    // api_usage 컬렉션: 승인된 사용자만 정해진 스키마로 로그 기록, 관리자는 전체 읽기 가능
    match /api_usage/{docId} {
      allow create: if request.auth != null
                    && isApproved()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'provider', 'timestamp'])
                    && request.resource.data.provider in ['openai', 'gemini'];
      allow read: if request.auth != null && isAdmin();
    }

    // board 컬렉션: 로그인한 사용자만 읽기/쓰기 가능
    match /board/{postId} {
      allow read: if request.auth != null && (
        isAdmin()
        || resource.data.isPrivate == false
        || request.auth.uid == resource.data.userId
      );
      // 필드 스키마를 고정해, 클라이언트 UI를 우회해 devtools로 직접
      // 호출하더라도 answered/answer(관리자 답변 여부)나 imageUrl(다른
      // 사용자가 보는 공개 게시글에서 추적 픽셀 등으로 악용 가능) 같은
      // 필드를 임의로 주입할 수 없도록 한다. 작성 시 answered/answer는
      // 반드시 초기값(false/"")이어야 한다.
      allow create: if request.auth != null
                    && isApproved()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                      'title', 'content', 'nickname', 'isPrivate', 'imageUrl',
                      'userId', 'userName', 'answered', 'answer',
                      'createdAt', 'updatedAt'
                    ])
                    && request.resource.data.answered == false
                    && request.resource.data.answer == ""
                    && isValidBoardImageUrl(request.resource.data.imageUrl);
      // 수정도 두 갈래로 분리한다: 글쓴이 본인은 게시글 본문(제목/내용/
      // 이미지 등)만 고칠 수 있고 답변 필드는 건드릴 수 없다. 관리자는
      // 답변 필드(answer/answered/answeredAt)만 고칠 수 있고 글쓴이의
      // 원본 내용은 건드릴 수 없다. 이렇게 하면 js/board.js의
      // submitBoardAnswer가 클라이언트단에서는 관리자 여부를 확인하지
      // 않지만, 일반 사용자가 devtools로 자기 게시글에 "관리자 답변"을
      // 위조하는 것도 서버 규칙에서 막힌다(소유자 갈래는 answer 필드
      // 변경을 허용하지 않음).
      allow update: if request.auth != null
                    && request.resource.data.userId == resource.data.userId
                    && (
                      (isAdmin()
                        && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['answer', 'answered', 'answeredAt']))
                      || (request.auth.uid == resource.data.userId
                        && isApproved()
                        && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['title', 'content', 'nickname', 'isPrivate', 'imageUrl', 'updatedAt'])
                        && isValidBoardImageUrl(request.resource.data.imageUrl))
                    );
      allow delete: if request.auth != null
                    && (isAdmin() || request.auth.uid == resource.data.userId);
    }

    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 관리자 승인(approved == true)을 받은 사용자만 통과
    function isApproved() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true;
    }

    // board 게시글의 imageUrl은 반드시 비어있거나 이 프로젝트의 Firebase
    // Storage 다운로드 URL이어야 한다. keys().hasOnly()는 필드가 "있는지"만
    // 검사할 뿐 값 자체는 검증하지 않아서, 이 제약이 없으면 승인된
    // 사용자가 devtools/REST로 imageUrl에 임의의 외부 URL(추적 픽셀 등)을
    // 넣은 공개 게시글을 만들 수 있었다(정밀 재분석 중 발견) — 그 글을
    // 여는 모든 사용자의 브라우저가 자동으로 그 외부 서버에 요청을 보내
    // IP/UA/Referer가 유출된다.
    function isValidBoardImageUrl(url) {
      return url == "" ||
             url.matches("^https://firebasestorage\\.googleapis\\.com/.*");
    }
  }
}
