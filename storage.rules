rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /board_images/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && firestore.get(
                              /databases/(default)/documents/users/$(request.auth.uid)
                            ).data.approved == true
                            && request.resource.size < 5 * 1024 * 1024
                            // SVG(image/svg+xml)는 제외한다: 내부에 <script>를 담을 수 있고,
                            // 게시판이 이미지를 새 탭에서 직접 여는 기능(window.open)을 제공하므로
                            // 허용 시 저장형 XSS로 이어질 수 있다.
                            && request.resource.contentType.matches('image/.*')
                            && request.resource.contentType != 'image/svg+xml';
      allow delete: if request.auth != null && (
        request.auth.uid == userId
        || firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.role == 'admin'
      );
    }

    // 기존 한 단계 경로의 이미지는 마이그레이션 기간 동안 읽기만 허용합니다.
    match /board_images/{legacyFileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
