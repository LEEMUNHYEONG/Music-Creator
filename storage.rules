rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isApprovedUser() {
      return request.auth != null &&
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.approved == true;
    }

    function isAdminUser() {
      return request.auth != null &&
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /board_images/{userId}/{fileName} {
      // 읽기: 로그인 + 승인된 사용자만 허용한다(기존에는 로그인만 하면
      // 미승인 사용자도 읽을 수 있었다 — 앱의 다른 모든 기능이 승인을
      // 요구하는 것과 어긋났음). 게시글이 비공개인 경우(업로드 시
      // js/board.js가 함께 기록하는 isPrivate 커스텀 메타데이터)에는
      // 작성자 본인 또는 관리자만 읽을 수 있도록 추가로 제한한다
      // (정밀 재분석 중 발견 — 비공개 게시글이어도 이미지 URL만 알면
      // 승인된 아무 사용자나 열람 가능했던 defense-in-depth 공백).
      // resource.metadata.isPrivate가 없는(이 필드 도입 이전) 레거시
      // 이미지는 공개로 취급해 하위 호환을 유지한다.
      allow read: if isApprovedUser() && (
        resource.metadata == null
        || !('isPrivate' in resource.metadata)
        || resource.metadata.isPrivate != 'true'
        || request.auth.uid == userId
        || isAdminUser()
      );
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && isApprovedUser()
                            && request.resource.size < 5 * 1024 * 1024
                            // SVG(image/svg+xml)는 제외한다: 내부에 <script>를 담을 수 있고,
                            // 게시판이 이미지를 새 탭에서 직접 여는 기능(window.open)을 제공하므로
                            // 허용 시 저장형 XSS로 이어질 수 있다.
                            && request.resource.contentType.matches('image/.*')
                            && request.resource.contentType != 'image/svg+xml';
      allow delete: if request.auth != null && (
        request.auth.uid == userId
        || isAdminUser()
      );
    }

    // 기존 한 단계 경로의 이미지는 마이그레이션 기간 동안 읽기만 허용합니다.
    match /board_images/{legacyFileName} {
      allow read: if isApprovedUser();
      allow write: if false;
    }
  }
}
