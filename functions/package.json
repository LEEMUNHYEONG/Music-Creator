{
  "name": "functions",
  "version": "1.0.0",
  "description": "Music Creator - Firebase Cloud Functions (API Proxy)",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "lint": "echo \"No linting configured\"",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
